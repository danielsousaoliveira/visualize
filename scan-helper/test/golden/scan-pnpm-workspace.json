{
  "schemaVersion": 1,
  "project": {
    "name": "fixture-pnpm-workspace",
    "rootPath": "/fixtures/scan/pnpm-workspace",
    "gitBranch": null,
    "type": "monorepo"
  },
  "services": [
    {
      "id": "apps/web",
      "name": "web",
      "kind": "app",
      "rootDirectory": "apps/web",
      "stackId": "vite",
      "category": "frontend",
      "packageManager": "npm",
      "installCommand": "npm i --force",
      "buildCommand": "npm run build",
      "startCommand": null,
      "port": 5173,
      "hasDockerfile": false,
      "devCommand": {
        "argv": [
          "pnpm",
          "run",
          "dev"
        ],
