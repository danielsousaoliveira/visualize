        "source": "script:dev"
      }
    },
    {
      "id": "apps/api",
      "name": "api",
      "kind": "app",
      "rootDirectory": "apps/api",
      "stackId": "express",
      "category": "backend",
      "packageManager": "npm",
      "installCommand": "npm i --force",
      "buildCommand": null,
      "startCommand": "npm run start",
      "port": 3000,
      "hasDockerfile": false,
      "devCommand": {
        "argv": [
          "pnpm",
          "run",
          "start"
        ],
        "workingDirectory": "apps/api",
        "source": "script:start"
      }
    }
  ],
