{
  "schemaVersion": 1,
  "project": {
    "name": "fixture-monorepo",
    "rootPath": "/fixtures/scan/monorepo",
    "gitBranch": null,
    "type": "monorepo"
  },
  "services": [
    {
      "id": "apps/web",
      "name": "web",
      "kind": "app",
      "rootDirectory": "apps/web",
      "stackId": "node",
      "category": "backend",
      "packageManager": "npm",
      "installCommand": "npm i --force",
      "buildCommand": "npm run build",
      "startCommand": "npm run start",
      "port": 3000,
      "hasDockerfile": false,
      "devCommand": {
        "argv": [
          "npm",
          "run",
          "dev"
        ],
        "workingDirectory": "apps/web",
        "source": "script:dev"
      }
    },
    {
      "id": "apps/api",
      "name": "api",
      "kind": "app",
      "rootDirectory": "apps/api",
      "stackId": "express",
      "category": "backend",
      "packageManager": "npm",
      "installCommand": "npm i --force",
      "buildCommand": null,
      "startCommand": "npm run start",
      "port": 3000,
      "hasDockerfile": true,
      "devCommand": {
        "argv": [
          "npm",
          "run",
          "start"
        ],
        "workingDirectory": "apps/api",
        "source": "script:start"
      }
    }
  ],
  "composeFiles": [],
  "composeServices": [],
  "envRequirements": [
    {
      "serviceId": "apps/web",
      "variables": [
        {
          "name": "NEXT_PUBLIC_API_URL",
          "status": "missing",
          "declaredIn": [
            "apps/web/.env.example"
          ]
        }
      ]
    },
    {
      "serviceId": "apps/api",
      "variables": [
        {
          "name": "API_KEY",
          "status": "set",
          "declaredIn": [
            "apps/api/.env.example",
            "apps/api/.env"
          ]
        },
        {
          "name": "DATABASE_URL",
          "status": "missing",
          "declaredIn": [
            "apps/api/.env.example"
          ]
        }
      ]
    }
  ],
  "infra": [],
  "connections": [],
  "warnings": []
}
