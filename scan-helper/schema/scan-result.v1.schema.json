{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "visualize scan result",
  "description": "Output of visualize-scan. Adding a field keeps schemaVersion; renaming or removing one bumps it. Environment values never appear, only names. Paths are relative to the scanned root, except project.rootPath.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "services",
    "composeFiles",
    "composeServices",
    "envRequirements",
    "infra",
    "connections",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rootPath", "gitBranch", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "rootPath": { "type": "string", "pattern": "^/" },
        "gitBranch": { "type": ["string", "null"] },
        "type": { "enum": ["app", "monorepo", "services", "docker"] }
      }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    },
    "composeFiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "composeServices": {
      "type": "array",
      "items": { "$ref": "#/$defs/composeService" }
    },
    "envRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/envRequirement" }
    },
    "infra": {
      "type": "array",
      "items": { "$ref": "#/$defs/infra" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "localRunMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "reason"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "available": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "composeRunMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "reason",
        "composeFile",
        "serviceName"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "composeFile": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/relativePath"
            }
          ]
        },
        "serviceName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "available": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dockerfileRunMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "reason",
        "dockerfilePath",
        "containerPort"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "dockerfilePath": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/relativePath"
            }
          ]
        },
        "containerPort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        }
      },
      "if": {
        "properties": {
          "available": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runModes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local",
        "compose",
        "dockerfile"
      ],
      "properties": {
        "local": {
          "$ref": "#/$defs/localRunMode"
        },
        "compose": {
          "$ref": "#/$defs/composeRunMode"
        },
        "dockerfile": {
          "$ref": "#/$defs/dockerfileRunMode"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^/" }
    },
    "nullableCommand": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "rootDirectory",
        "stackId",
        "category",
        "packageManager",
        "installCommand",
        "buildCommand",
        "startCommand",
        "port",
        "hasDockerfile",
        "devCommand",
        "runModes"
      ],
      "properties": {
        "id": {
          "description": "The relative root directory for an app service, compose:<name> for a compose service.",
          "type": "string",
          "minLength": 1
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["app", "compose"] },
        "rootDirectory": { "$ref": "#/$defs/relativePath" },
        "stackId": { "type": ["string", "null"], "minLength": 1 },
        "category": { "type": ["string", "null"], "minLength": 1 },
        "packageManager": { "type": ["string", "null"], "minLength": 1 },
        "installCommand": { "$ref": "#/$defs/nullableCommand" },
        "buildCommand": { "$ref": "#/$defs/nullableCommand" },
        "startCommand": { "$ref": "#/$defs/nullableCommand" },
        "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "hasDockerfile": {
          "description": "For a compose service, true only when it builds from a local context that holds its Dockerfile.",
          "type": "boolean"
        },
        "runModes": { "$ref": "#/$defs/runModes" },
        "devCommand": {
          "description": "What a developer would type to run the service locally. Null when none could be derived; a warning then says why.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/devCommand" }]
        }
      }
    },
    "devCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "workingDirectory", "source"],
      "properties": {
        "argv": {
          "description": "Program and arguments, run without a shell. Install steps are never chained in.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "workingDirectory": { "$ref": "#/$defs/relativePath" },
        "source": {
          "type": "string",
          "pattern": "^(script:.+|stack-default|fallback-start)$"
        }
      }
    },
    "portMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "container"],
      "properties": {
        "host": {
          "description": "Published host port, or an unresolved ${VAR} expression. Null when the port is not published to a fixed host port.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "container": { "type": "string", "minLength": 1 }
      }
    },
    "infra": {
      "description": "A database or cache the project needs. One entry per compose service that provides the kind and per distinct external host and port, and one for the kind when neither applies. Env values are read only for scheme, host and port.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "usedBy", "providedBy", "evidence", "host", "port"],
      "properties": {
        "id": {
          "description": "infra:<kind> for the first entry of a kind, infra:<kind>-<n> for the nth.",
          "type": "string",
          "pattern": "^infra:"
        },
        "kind": { "enum": ["postgres", "mysql", "mongodb", "redis", "sqlite"] },
        "usedBy": {
          "description": "Ids of the services that use it.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "providedBy": {
          "description": "Id of the compose service whose image provides it, or null when nothing in the repo runs it.",
          "type": ["string", "null"],
          "pattern": "^compose:"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "host": { "type": ["string", "null"], "minLength": 1 },
        "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
      }
    },
    "connection": {
      "description": "A directed edge between two services, or from a service to an infra entry. At most one per from, to and kind. Edges whose target is not in the scan are left out with a warning.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "label"],
      "properties": {
        "from": { "description": "Service id.", "type": "string", "minLength": 1 },
        "to": { "description": "Service id or infra id.", "type": "string", "minLength": 1 },
        "kind": {
          "description": "depends_on: compose depends_on. env-url: an env value is a URL whose host and port match the target. uses-infra: the source uses the infra entry. workspace-dep: a monorepo app lists another app as a dependency.",
          "enum": ["depends_on", "env-url", "uses-infra", "workspace-dep"]
        },
        "label": {
          "description": "depends_on, the env variable name, the infra kind, or the package name.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "envRequirement": {
      "description": "One entry per service. Read from .env.example, .env.sample and .env.template (expected) and .env, .env.local, .env.development, .env.development.local and compose env_file entries (set), in the service root and the repo root. Values never appear.",
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceId", "variables"],
      "properties": {
        "serviceId": { "type": "string", "minLength": 1 },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/envVariable" }
        }
      }
    },
    "envVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "declaredIn"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "status": {
          "description": "set: expected and has a non-empty value. missing: expected with no non-empty value. extra: has a value but no example file lists it.",
          "enum": ["set", "missing", "extra"]
        },
        "declaredIn": {
          "description": "Every file that names the variable, examples first.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "composeService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "buildContext", "ports", "dependsOn", "environment"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "image": { "type": ["string", "null"], "minLength": 1 },
        "buildContext": { "type": ["string", "null"], "minLength": 1 },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/portMapping" } },
        "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "environment": {
          "description": "Variable names only. Values never appear.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
